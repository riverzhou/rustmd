# Maintainer: River Zhou <riverzhou2000@163.com>

pkgname=rustmd-bin
pkgver=1.10.5
pkgrel=1
pkgdesc='Local-first Markdown, HTML, CSV, TXT and JSON notes (prebuilt AppImage)'
arch=('x86_64')
url='https://github.com/riverzhou/rustmd'
license=('GPL-3.0-or-later')
depends=('gtk3' 'webkit2gtk-4.1' 'libsoup3')
provides=('rustmd')
conflicts=('rustmd' 'rustmd-git')
options=('!strip' '!debug')
source=("rustmd-${pkgver}.AppImage::https://github.com/riverzhou/rustmd/releases/download/v${pkgver}/rustmd_${pkgver}_amd64.AppImage")
sha256sums=('3e5640f0bc0f0c38fbe2672d849950272b32274abe5ea1eb0206fd3361d29f19')

prepare() {
  chmod +x "${srcdir}/rustmd-${pkgver}.AppImage"
  # Extract the AppDir instead of mounting it through FUSE: the package then
  # runs on systems without libfuse2 and makepkg never needs a working FUSE.
  ( cd "${srcdir}" && ./rustmd-"${pkgver}".AppImage --appimage-extract >/dev/null )
}

package() {
  cp -a "${srcdir}/squashfs-root/usr" "${pkgdir}/"
}
