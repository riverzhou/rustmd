{
  "name": "rustmd",
  "private": true,
  "version": "1.11.2",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js",
    "tauri": "tauri",
    "icons": "node scripts/dev/gen-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit && npm run test:rust",
    "test:unit": "node --test frontend/src/shared/notelist.test.js frontend/src/shared/markdown.test.js frontend/src/shared/i18n.test.js frontend/src/shared/dataformat.test.js frontend/src/layout.test.js frontend/src/pdfgeom.test.js frontend/src/exportgeom.test.js frontend/src/vaultlist.test.js",
    "test:rust": "node scripts/lib/cargo.mjs test --workspace",
    "check:version": "node scripts/checks/check-version.mjs",
    "check:repo": "node scripts/checks/check-repo.mjs",
    "check:license": "node scripts/checks/check-license-boundary.mjs",
    "check:rust": "node scripts/lib/cargo.mjs fmt --all --check && node scripts/lib/cargo.mjs clippy --workspace --all-targets -- -D warnings && node scripts/lib/cargo.mjs test --workspace",
    "check": "npm run lint && npm run test:unit && npm run check:repo && npm run check:license && npm run check:packaging && npm run check:version && npm run check:rust && npm run build",
    "selftest": "node scripts/dev/run-selftest.mjs",
    "selftest:check": "node scripts/checks/check-selftest-report.mjs --require-html --require-data",
    "release:notes": "node scripts/release/release-notes.mjs",
    "check:packaging": "node scripts/checks/check-packaging.mjs"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@mathjax/mathjax-bbm-font-extension": "^4.1.3",
    "@mathjax/mathjax-bboldx-font-extension": "^4.1.3",
    "@mathjax/mathjax-dsfont-font-extension": "^4.1.3",
    "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "marked": "^18.2.1",
    "mathjax": "^4.1.3",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  },
  "license": "GPL-3.0-or-later",
  "author": "River"
}
